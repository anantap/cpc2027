{
  "rewrites": [
    {
      "source": "/",
      "destination": "/trainingsplan.html"
    }
  ],
  "functions": {
    "api/summary.js": {
      "maxDuration": 60
    },
    "api/week-summary.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/trainingsplan.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
